{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.schema.json",
  "title": "JEV QA verdict (vnext-plan phase 5; shape chosen here, the plan names QA but gives no contract)",
  "type": "object",
  "required": [
    "verdict",
    "checks",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "target": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "out_dir": {
      "type": "string"
    }
  }
}
