{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jev_handoff.schema.json",
  "title": "JEV builder/engineer completion handoff (vnext-plan section 10)",
  "type": "object",
  "required": [
    "task_id",
    "role",
    "status",
    "files_changed",
    "implementation_summary",
    "tests_run",
    "test_results",
    "risks",
    "next_recommended_agent"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "pattern": "^jev-"
    },
    "status": {
      "enum": [
        "completed",
        "partial"
      ]
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved": {
      "type": "array"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_recommended_agent": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string",
        "pattern": "^(jev-|orchestrator$)"
      },
      "pattern": "^(jev-|orchestrator$)"
    }
  }
}
