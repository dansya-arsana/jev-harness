{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jev_plan.schema.json",
  "title": "JEV architect plan (vnext-plan section 10, 'Architect Output Contract')",
  "description": "Returned by the read-only jev-architect as text; the orchestrator persists it with `jev.py plan save`. A fresh builder must be able to implement it without the architect's conversation.",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "assumptions",
    "constraints",
    "files_to_inspect",
    "likely_files_to_modify",
    "implementation_steps",
    "invariants",
    "acceptance_criteria",
    "escalation_conditions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files_to_inspect": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "likely_files_to_modify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
